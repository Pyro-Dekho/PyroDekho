# Backend API used by the browser (replaces VITE_API_BASE_URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Live site address, used for share cards (Open Graph / Twitter).
# Defaults to https://pyrodekho.com when not set.
NEXT_PUBLIC_SITE_URL=https://pyrodekho.com

# Optional: API URL used by the Next.js server when rendering pages.
# On the VPS this can point straight at the backend (e.g. http://localhost:5000/api).
# Falls back to NEXT_PUBLIC_API_BASE_URL when not set.
API_BASE_URL=
